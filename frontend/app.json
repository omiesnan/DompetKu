{
  "expo": {
    "name": "Finance Tracker",
    "slug": "finance-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-image.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSUserTrackingUsageDescription": "Lacak pengeluaran Anda dengan mudah"
      },
      "bundleIdentifier": "com.financetracker.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-image.png",
        "backgroundColor": "#4CAF50"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ],
      "package": "com.financetracker.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4CAF50"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/app-image.png",
          "color": "#4CAF50",
          "androidMode": "default",
          "androidCollapsedTitle": "Finance Tracker"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
